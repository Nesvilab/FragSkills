{
  "schema": 1,
  "about": "Questions and routes for build_workflow.py. Every shipped FragPipe workflow is one route: the answers that select it. Questions are asked in this order, each only when its 'when' holds, offering only the answers that still lead to a route. Keys are FragPipe 24.1 names; 'versions' maps them for other versions. See docs/workflow-builder-plan.md.",
  "reference_version": "24.1",
  "versions": {
    "24.1": {
      "validated": "FragPipe 24.1-build61",
      "renames": {}
    },
    "25.0": {
      "validated": "FragPipe develop 5ae846bf4 (25.0-build3); re-check at the 25.0 release",
      "renames": {
        "fragdia.mbr": "fragdia.plr",
        "fragdia.mbr-global-q": "fragdia.plr-global-q",
        "fragdia.ms1-tol": "fragdia.precursor-tol",
        "fragdia.ms2-tol": "fragdia.fragment-tol",
        "metaproteomics.cmd-line-opts": "fragmeta.cmd-line-opts",
        "metaproteomics.delta-hyperscore": "fragmeta.delta-hyperscore",
        "metaproteomics.host-name": "fragmeta.host-name",
        "metaproteomics.iterations": "fragmeta.iterations",
        "metaproteomics.min-pept-cnt-per-prot": "fragmeta.min-pept-cnt-per-prot",
        "metaproteomics.min-uniq-pept-cnt": "fragmeta.min-uniq-pept-cnt",
        "metaproteomics.min-uniq-pept-cnt-per-prot": "fragmeta.min-uniq-pept-cnt-per-prot",
        "metaproteomics.qvalue": "fragmeta.qvalue",
        "metaproteomics.run-metaproteomics": "fragmeta.run-fragmeta"
      }
    }
  },
  "questions": [
    {
      "id": "analysis",
      "keep_in_nearest": true,
      "text": "What kind of analysis is this?",
      "answers": [
        {"value": "standard", "label": "Standard: whole proteome, PTM enrichment, labelling, immunopeptidomics"},
        {"value": "glyco", "label": "Glycoproteomics (N- or O-glycopeptides)"},
        {"value": "specialised", "label": "A specialised FragPipe workflow, picked by name"}
      ]
    },
    {
      "id": "specialised",
      "text": "Which specialised workflow?",
      "when": {"analysis": ["specialised"]},
      "answers": [
        {"value": "chemprot-ABPP-diaTOP", "label": "Cysteine ABPP, IA-alkyne acid-cleavable tag, DIA quantification"},
        {"value": "chemprot-ABPP-IADTB-diaPASEF", "label": "Cysteine ABPP with IA-DTB, diaPASEF quantification"},
        {"value": "chemprot-ABPP-IADTB-TMT16", "label": "Cysteine ABPP with IA-DTB, TMT16 quantification"},
        {"value": "chemprot-ABPP-ipIAA", "label": "Cysteine profiling with isotopic isopropyl iodoacetamide alkyne (light/heavy)"},
        {"value": "chemprot-ABPP-isoDTB", "label": "Cysteine profiling with isoDTB tags (MS1 light/heavy)"},
        {"value": "chemprot-ABPP-isoTOP", "label": "isoTOP-ABPP cysteine reactivity profiling"},
        {"value": "chemprot-PAL", "label": "Photoaffinity labelling, mass-offset search"},
        {"value": "citrullination", "label": "Citrullination, hybrid search with diagnostic ion"},
        {"value": "DIA_DIA-Umpire_SpecLib_Quant", "label": "DIA through DIA-Umpire pseudo-MS/MS (Thermo/Sciex)"},
        {"value": "Diagnostic-ion-mining", "label": "Open search with diagnostic ion mining"},
        {"value": "FPOP", "label": "Fast photochemical oxidation of proteins (FPOP)"},
        {"value": "Labile_ADP-ribosylation", "label": "ADP-ribosylation, labile search"},
        {"value": "Labile_phospho", "label": "Phosphorylation, labile search"},
        {"value": "Nonspecific-HLA-customDB-groupFDR", "label": "HLA peptidome, custom database with group FDR by protein evidence"},
        {"value": "Nonspecific-HLA-glyco", "label": "Glycopeptides in HLA peptidome data"},
        {"value": "Stellar-DDA", "label": "Stellar (unit resolution) DDA, or GPF-DIA searched as DDA"},
        {"value": "Stellar-GPFDIA", "label": "Stellar (unit resolution) GPF-DIA"},
        {"value": "XRNAX-MassOffset", "label": "XRNAX protein-RNA crosslinks, mass-offset search"}
      ]
    },
    {
      "id": "acquisition",
      "keep_in_nearest": true,
      "text": "How were the spectra acquired?",
      "when": {"analysis": ["standard", "glyco"]},
      "answers": [
        {"value": "DDA", "label": "DDA"},
        {"value": "DDA+", "label": "Wide-window DDA (WWA)"},
        {"value": "DIA", "label": "DIA, including diaPASEF"}
      ]
    },
    {
      "id": "dia_format",
      "keep_in_nearest": true,
      "always_ask": true,
      "text": "Which instrument produced the DIA runs?",
      "when": {"acquisition": ["DIA"]},
      "answers": [
        {"value": "thermo_sciex", "label": "Thermo or Sciex (mzML or .raw)"},
        {"value": "diapasef", "label": "Bruker timsTOF diaPASEF (.d)"}
      ]
    },
    {
      "id": "glyco_type",
      "text": "Which glycopeptides?",
      "when": {"analysis": ["glyco"]},
      "answers": [
        {"value": "N", "label": "N-glycopeptides"},
        {"value": "O", "label": "O-glycopeptides"}
      ]
    },
    {
      "id": "glyco_activation",
      "text": "How were the glycopeptides fragmented?",
      "when": {"analysis": ["glyco"]},
      "answers": [
        {"value": "hcd", "label": "CID/HCD"},
        {"value": "hybrid", "label": "Hybrid activation (EThcD and similar), one scan per precursor"},
        {"value": "paired", "label": "Paired scans (HCD followed by ETD/EThcD), for O-Pair localization"}
      ]
    },
    {
      "id": "search",
      "text": "What kind of database search?",
      "when": {"analysis": ["standard", "glyco"]},
      "answers": [
        {"value": "closed", "label": "Closed search (tryptic, listed modifications)"},
        {"value": "open", "label": "Open search (unknown mass shifts)"},
        {"value": "mass_offset", "label": "Mass-offset search for common PTMs"},
        {"value": "nonspecific_hla", "label": "Nonspecific search for HLA (MHC) peptides"},
        {"value": "peptidome", "label": "Nonspecific search for endogenous peptides (plasma, CSF)"}
      ]
    },
    {
      "id": "quant",
      "text": "How are the samples quantified?",
      "when": {"analysis": ["standard", "glyco"]},
      "answers": [
        {"value": "none", "label": "No quantification, identification only"},
        {"value": "LFQ", "label": "Label-free (IonQuant for DDA, DIA-NN for DIA)"},
        {"value": "TMT", "label": "TMT or TMTpro"},
        {"value": "iTRAQ", "label": "iTRAQ 4-plex"},
        {"value": "SILAC", "label": "SILAC (light, medium, heavy)"}
      ]
    },
    {
      "id": "tmt_plex",
      "keep_in_nearest": true,
      "text": "How many TMT channels per plex?",
      "when": {"quant": ["TMT"]},
      "answers": [
        {"value": "6", "label": "TMT 6-plex"},
        {"value": "10", "label": "TMT 10-plex"},
        {"value": "11", "label": "TMT 11-plex"},
        {"value": "16", "label": "TMTpro 16-plex"},
        {"value": "18", "label": "TMTpro 18-plex"},
        {"value": "35", "label": "TMTpro 35-plex"}
      ]
    },
    {
      "id": "tmt_astral",
      "text": "Were the TMTpro 18-plex data acquired on an Orbitrap Astral?",
      "when": {"tmt_plex": ["18"]},
      "answers": [
        {"value": "yes", "label": "Yes, Orbitrap Astral"},
        {"value": "no", "label": "No, another Orbitrap"}
      ]
    },
    {
      "id": "tmt_ms_level",
      "text": "Where are the reporter ions measured?",
      "when": {"quant": ["TMT"]},
      "answers": [
        {"value": "MS2", "label": "MS2 (high-resolution)"},
        {"value": "MS3", "label": "MS3 (SPS-MS3; identification from ion-trap MS2)"}
      ]
    },
    {
      "id": "tmt_reference",
      "always_ask": true,
      "text": "How are the plexes normalised?",
      "when": {"quant": ["TMT"]},
      "answers": [
        {"value": "virtual", "label": "Virtual reference (no pooled channel)"},
        {"value": "bridge", "label": "A pooled bridge channel in every plex (sample names pool_1, pool_2, ...)"}
      ]
    },
    {
      "id": "ptm",
      "always_ask": true,
      "text": "Were the samples enriched for a PTM?",
      "when": {"analysis": ["standard"], "search": ["closed", "nonspecific_hla"]},
      "answers": [
        {"value": "none", "label": "No enrichment"},
        {"value": "phospho", "label": "Phosphorylation (STY)"},
        {"value": "ubiquitin", "label": "Ubiquitination (K-GG remnant)"},
        {"value": "acetyl", "label": "Lysine acetylation"}
      ]
    },
    {
      "id": "ubiq_tmt_lysine",
      "text": "How should TMT and the GG remnant share lysines?",
      "when": {"quant": ["TMT"], "ptm": ["ubiquitin"]},
      "answers": [
        {"value": "tmt_or_ubiq", "label": "A lysine carries either TMT or GG, not both (PTMProphet localization)"},
        {"value": "tmt_plus_ubiq", "label": "GG lysines are also TMT-labelled (+343 or +418 combined)"},
        {"value": "both", "label": "Allow both cases (TMT10 only; localization from MSFragger)"}
      ]
    },
    {
      "id": "acetyl_localization",
      "text": "How should acetylation sites be localized?",
      "when": {"quant": ["TMT"], "ptm": ["acetyl"]},
      "answers": [
        {"value": "ptmprophet", "label": "PTMProphet"},
        {"value": "msfragger", "label": "MSFragger's own assignment (no PTMProphet)"}
      ]
    },
    {
      "id": "hla_alkylated",
      "text": "Were cysteines alkylated (iodoacetamide)?",
      "when": {"search": ["nonspecific_hla"]},
      "answers": [
        {"value": "no", "label": "No"},
        {"value": "yes", "label": "Yes"}
      ]
    },
    {
      "id": "dia_astral",
      "text": "Narrow-window Orbitrap Astral DIA?",
      "when": {"search": ["nonspecific_hla"], "dia_format": ["thermo_sciex"]},
      "answers": [
        {"value": "yes", "label": "Yes, Astral narrow-window DIA"},
        {"value": "no", "label": "No (DIA-Umpire pseudo-MS/MS)"}
      ]
    },
    {
      "id": "open_variant",
      "text": "Full open search or a quick scan?",
      "when": {"search": ["open"], "quant": ["none"], "analysis": ["standard"]},
      "answers": [
        {"value": "full", "label": "Full open search (localization-aware, parameter optimization)"},
        {"value": "quick", "label": "Quick scan (narrower mass range, no optimization)"}
      ]
    },
    {
      "id": "dia_library",
      "text": "How is the DIA spectral library built?",
      "when": {"acquisition": ["DIA"]},
      "answers": [
        {"value": "empirical", "label": "Empirical: searched from these runs (DIA, and DDA or GPF-DIA library runs if any)"}
      ]
    }
  ],
  "settings": [
    {
      "id": "fasta",
      "kind": "path",
      "text": "Protein database (FASTA). It must already contain decoys (rev_) and, ideally, contaminants (contam_).",
      "key": "database.db-path",
      "why": "No shipped workflow names a database; every run needs one."
    },
    {
      "id": "remove_contaminants",
      "kind": "choice",
      "text": "Remove contaminant proteins (contam_ entries) from the reports?",
      "key": "phi-report.remove-contaminants",
      "default": "yes",
      "answers": [
        {"value": "yes", "label": "Yes: drop contaminant PSMs, peptides and proteins before quantification", "set": "true"},
        {"value": "no", "label": "No: keep them, flagged in 'Is Contaminant' (FragPipe's default)", "set": "false"}
      ],
      "why": "Philosopher report --removecontam drops PSMs whose main protein is contam_, so IonQuant, TMT-Integrator and the DIA library never see them."
    }
  ],
  "derived": [
    {
      "key": "tmtintegrator.channel_num",
      "from": "tmt_plex",
      "format": "TMT-{}",
      "why": "Plex size within a reagent family is a run-level setting (TMT-6/10/11 share 229.163, TMTpro-16/18 share 304.207)."
    }
  ],
